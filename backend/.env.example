# Copy this file to .env on the VPS. Never commit real values.
PORT=3000
NODE_ENV=production

# JSON-encoded Firebase Admin service account. Keep this secret on the VPS only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time first-admin bootstrap. Use a long random secret.
BOOTSTRAP_ADMIN_UID=5eqviQSoSyUtvASAKOleajsUru63
BOOTSTRAP_SECRET=

# Comma-separated browser origins. Add the custom webmail domain when configured.
ALLOWED_ORIGINS=https://priyabratacare-source.github.io
